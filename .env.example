# Copy to `.env` for local development: `cp .env.example .env`.
# `.env` is git-ignored; this file documents which variables exist.

# Postgres connection used by `pnpm dev`, `pnpm db:migrate`, and as the server
# on which `pnpm test` creates its throwaway test databases. Matches the
# container in compose.yaml.
DATABASE_URL=postgres://showtakes:showtakes@localhost:5433/showtakes

# Email (src/mail/create-mailer.ts). Locally, every email goes to the Mailpit
# inbox in compose.yaml, readable at MAILPIT_URL, and is delivered to nobody.
# Production sets MAIL_PROVIDER=resend and RESEND_API_KEY instead (the "First
# deploy" ticket); never put a real Resend key in this file.
MAIL_PROVIDER=mailpit
MAIL_FROM=noreply@showtakes.test
MAILPIT_URL=http://localhost:8025

# Logins (src/auth/auth.ts). BETTER_AUTH_URL is the site's public address: links
# in emails point there, and Better Auth refuses requests from any other origin.
# BETTER_AUTH_SECRET signs cookies and tokens; the value below is for local
# development only. Production uses a long random secret
# (`openssl rand -base64 32`) set in the host's settings (the "First deploy"
# ticket).
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=local-development-only-secret-not-for-production
