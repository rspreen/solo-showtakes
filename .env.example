# Copy to `.env` for local development: `cp .env.example .env`.
# `.env` is git-ignored; this file documents which variables exist.

# Postgres connection used by `pnpm dev`, `pnpm db:migrate`, and as the server
# on which `pnpm test` creates its throwaway test databases. Matches the
# container in compose.yaml.
DATABASE_URL=postgres://showtakes:showtakes@localhost:5433/showtakes
